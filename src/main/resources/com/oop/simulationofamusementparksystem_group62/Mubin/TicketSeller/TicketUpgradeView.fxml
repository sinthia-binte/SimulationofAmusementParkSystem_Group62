<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="425.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Mubin.TicketSeller.TicketUpgradeViewController">
    <children>
        <Label layoutX="91.0" layoutY="42.0" text="Independent Amusement Park" />
        <Label layoutX="91.0" layoutY="60.0" text="User Dashboard">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <Label layoutX="446.0" layoutY="42.0" text="Ticket Seller" textFill="#4e96cf" />
        <Label layoutX="381.0" layoutY="60.0" text="Ticket Upgrade" textFill="#4e96cf">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <Line endX="319.33331298828125" endY="1.52587890625E-5" layoutX="192.0" layoutY="90.0" startX="-100.0" />

        <Label layoutX="90.0" layoutY="105.0" text="Original Ticket No." />
        <TextField fx:id="ticketNoTF" layoutX="232.0" layoutY="101.0" prefHeight="25.0" prefWidth="279.0" />

        <Button layoutX="90.0" layoutY="140.0" mnemonicParsing="false" onAction="#retrieveTicketButtonOA" prefHeight="25.0" prefWidth="421.0" text="Retrieve Ticket" />

        <Label layoutX="90.0" layoutY="180.0" text="Upgrade Option" />
        <ComboBox fx:id="upgradeOptionComboBox" layoutX="232.0" layoutY="176.0" prefHeight="25.0" prefWidth="279.0" />

        <Label layoutX="90.0" layoutY="216.0" text="Price Difference" />
        <Label fx:id="priceDifferenceLabel" layoutX="230.0" layoutY="216.0" prefHeight="17.0" prefWidth="279.0" style="-fx-background-color: yellow;" />

        <Button layoutX="90.0" layoutY="252.0" mnemonicParsing="false" onAction="#adjustPaymentBjuttonOA" prefHeight="25.0" prefWidth="421.0" text="Adjust Payment" />

        <Label layoutX="90.0" layoutY="292.0" text="Upgrade Confirmation" />
        <Label fx:id="upgradeConfirmationLabel" layoutX="229.0" layoutY="292.0" prefHeight="17.0" prefWidth="279.0" style="-fx-background-color: yellow;" />

        <Button layoutX="99.0" layoutY="342.0" mnemonicParsing="false" onAction="#backToDashboardButtonOA" prefHeight="25.0" prefWidth="120.0" text="Back" />
        <Button layoutX="379.0" layoutY="342.0" mnemonicParsing="false" onAction="#logOutButtonOA" prefHeight="25.0" prefWidth="120.0" text="Log Out" textFill="RED" />
    </children>
</AnchorPane>
