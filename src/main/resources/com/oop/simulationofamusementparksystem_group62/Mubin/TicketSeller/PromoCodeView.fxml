<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Mubin.TicketSeller.PromoCodeViewController">
    <children>
        <Label layoutX="91.0" layoutY="42.0" text="Independent Amusement Park" />
        <Label layoutX="91.0" layoutY="60.0" text="User Dashboard">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <Label layoutX="449.0" layoutY="42.0" text="Ticket Seller" textFill="#4e83cf" />
        <Label layoutX="359.0" layoutY="60.0" text="Promotional Code" textFill="#4e83cf">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <Line endX="319.33331298828125" endY="1.52587890625E-5" layoutX="192.0" layoutY="90.0" startX="-100.0" />

        <Label layoutX="90.0" layoutY="105.0" text="Promo Code / Voucher No." />
        <TextField fx:id="promoCodeTF" layoutX="261.0" layoutY="101.0" prefHeight="25.0" prefWidth="250.0" />

        <Button layoutX="90.0" layoutY="165.0" mnemonicParsing="false" onAction="#validateCodeButtonOA" prefHeight="25.0" prefWidth="421.0" text="Validate Code" />

        <Label layoutX="90.0" layoutY="214.0" text="Discount Applied" />
        <Label fx:id="discountAppliedLabel" layoutX="260.0" layoutY="214.0" prefHeight="17.0" prefWidth="250.0" style="-fx-background-color: yellow;" />

        <Label layoutX="90.0" layoutY="240.0" text="New Total" />
        <Label fx:id="newTotalLabel" layoutX="260.0" layoutY="240.0" prefHeight="17.0" prefWidth="250.0" style="-fx-background-color: yellow;" />

        <Button layoutX="90.0" layoutY="272.0" mnemonicParsing="false" onAction="#completeSaleButtonOA" prefHeight="25.0" prefWidth="421.0" text="Confirm &amp; Complete Sale" />

        <Button layoutX="100.0" layoutY="324.0" mnemonicParsing="false" onAction="#backToDashboardButtonOA" prefHeight="25.0" prefWidth="120.0" text="Back" />
        <Button layoutX="380.0" layoutY="324.0" mnemonicParsing="false" onAction="#logOutButtonOA" prefHeight="25.0" prefWidth="120.0" text="Log Out" textFill="RED" />
      <Label layoutX="90.0" layoutY="136.0" text="Ticket No." />
      <TextField fx:id="ticketNoTF" layoutX="261.0" layoutY="132.0" prefHeight="25.0" prefWidth="250.0" />
