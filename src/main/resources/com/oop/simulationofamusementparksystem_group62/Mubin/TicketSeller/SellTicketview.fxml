<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="514.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Mubin.TicketSeller.SellTicketViewController">
    <children>
        <Label layoutX="91.0" layoutY="42.0" text="Independent Amusement Park" />
        <Label layoutX="91.0" layoutY="60.0" text="User Dashboard">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <Label layoutX="447.0" layoutY="42.0" text="Ticket Seller" textFill="#4ea5cf" />
        <Label layoutX="425.0" layoutY="60.0" text="Sell Ticket" textFill="#4ea5cf">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <Line endX="319.33331298828125" endY="1.52587890625E-5" layoutX="192.0" layoutY="90.0" startX="-100.0" />

        <Label layoutX="90.0" layoutY="139.0" text="Number of Visitors" />
        <TextField fx:id="visitorCountTF" layoutX="260.0" layoutY="135.0" prefHeight="25.0" prefWidth="251.0" />

        <Label layoutX="90.0" layoutY="174.0" text="Age Category" />
        <ComboBox fx:id="ageCategoryComboBox" layoutX="260.0" layoutY="170.0" prefHeight="25.0" prefWidth="251.0" />

        <Label layoutX="90.0" layoutY="209.0" text="Ticket Type" />
        <ComboBox fx:id="ticketTypeComboBox" layoutX="260.0" layoutY="205.0" prefHeight="25.0" prefWidth="251.0" />

        <Button layoutX="90.0" layoutY="244.0" mnemonicParsing="false" onAction="#checkAvailabilityButtonOA" prefHeight="25.0" prefWidth="421.0" text="Check Availability" />

        <Label layoutX="90.0" layoutY="325.0" text="Price" />
        <Label fx:id="ticketPriceLabel" layoutX="182.0" layoutY="325.0" prefHeight="17.0" prefWidth="329.0" style="-fx-background-color: yellow;" />

        <Button layoutX="90.0" layoutY="357.0" mnemonicParsing="false" onAction="#processPaymentButtonOA" prefHeight="25.0" prefWidth="421.0" text="Confirm Payment" />

        <Label layoutX="90.0" layoutY="395.0" text="Transaction ID" />
        <Label fx:id="transactionIdLabel" layoutX="182.0" layoutY="395.0" prefHeight="17.0" prefWidth="329.0" style="-fx-background-color: yellow;" />

        <Button layoutX="101.0" layoutY="434.0" mnemonicParsing="false" onAction="#backToDashboardButtonOA" prefHeight="25.0" prefWidth="120.0" text="Back" />
        <Button layoutX="381.0" layoutY="434.0" mnemonicParsing="false" onAction="#logOutButtonOA" prefHeight="25.0" prefWidth="120.0" text="Log Out" textFill="RED" />
      <TextField fx:id="ticketNoTF" layoutX="260.0" layoutY="101.0" prefHeight="25.0" prefWidth="251.0" />
      <Label layoutX="90.0" layoutY="105.0" text="Ticket No." />
      <Label fx:id="isTicketAvailableLabel" layoutX="183.0" layoutY="290.0" prefHeight="17.0" prefWidth="329.0" style="-fx-background-color: yellow;" />
      <Label layoutX="91.0" layoutY="290.0" text="Is Available?" />
    </children>
