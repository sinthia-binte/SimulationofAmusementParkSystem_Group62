<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Mubin.RideOperator.ManageQueueViewController">
    <children>
        <Label layoutX="91.0" layoutY="42.0" text="Independent Amusement Park" />
        <Label layoutX="91.0" layoutY="60.0" text="User Dashboard">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <Label layoutX="435.0" layoutY="42.0" text="Ride Operator" textFill="#4fd058" />
        <Label layoutX="337.0" layoutY="60.0" text="Queue Management" textFill="#4fd058">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <Line endX="319.33331298828125" endY="1.52587890625E-5" layoutX="192.0" layoutY="90.0" startX="-100.0" />

        <Button layoutX="90.0" layoutY="102.0" mnemonicParsing="false" onAction="#loadQueueStatusOA" prefHeight="25.0" prefWidth="421.0" text="Load Current Queue Status" />

        <Label layoutX="90.0" layoutY="142.0" text="Current Queue Length" />
        <Label fx:id="queueLengthLabel" layoutX="240.0" layoutY="142.0" prefHeight="17.0" prefWidth="269.0" style="-fx-background-color: yellow;" />

        <Label layoutX="90.0" layoutY="177.0" text="Estimated Wait Time" />
        <Label fx:id="waitTimeLabel" layoutX="237.0" layoutY="177.0" prefHeight="17.0" prefWidth="269.0" style="-fx-background-color: yellow;" />

        <Button layoutX="90.0" layoutY="212.0" mnemonicParsing="false" onAction="#requestCrowdControlOA" prefHeight="25.0" prefWidth="421.0" text="Request Crowd Control" />

        <Button layoutX="90.0" layoutY="252.0" mnemonicParsing="false" onAction="#addWaitTimeOA" prefHeight="25.0" prefWidth="421.0" text="Add 5 min Wait Time" />

        <Label layoutX="90.0" layoutY="292.0" text="Confirmation" />
        <Label fx:id="confirmationLabel" layoutX="238.0" layoutY="292.0" prefHeight="17.0" prefWidth="269.0" style="-fx-background-color: yellow;" />

        <Button layoutX="90.0" layoutY="349.0" mnemonicParsing="false" onAction="#backToDashboardOA" prefHeight="25.0" prefWidth="120.0" text="Back" />
        <Button layoutX="386.0" layoutY="349.0" mnemonicParsing="false" onAction="#logOutOA" prefHeight="25.0" prefWidth="120.0" text="Log Out" textFill="RED" />
    </children>
</AnchorPane>
