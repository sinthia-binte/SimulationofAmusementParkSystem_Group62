<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="750.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Veronica.MaintenanceTechnician.MaintenanceTaskController">

    <children>
        <Label layoutX="280" layoutY="20" style="-fx-font-size:22px; -fx-font-weight:bold;" text="Task Completion Update" />
        <Label layoutX="40" layoutY="80" text="Assigned Task ID" />
        <ComboBox fx:id="TaskCB" layoutX="180" layoutY="75" onAction="#loadTaskDetailsOA" prefWidth="250" />
        <Label layoutX="40" layoutY="130" text="Task Description" />
        <Label layoutX="40" layoutY="230" text="Location" />
        <TextField fx:id="LocationTF" editable="false" layoutX="180" layoutY="225" prefWidth="250" />
        <Label layoutX="40" layoutY="280" text="Current Status" />
        <TextField fx:id="CurrentStatusTF" editable="false" layoutX="180" layoutY="275" prefWidth="250" />
        <Label layoutX="40" layoutY="340" text="Work Done" />
        <Label layoutX="40" layoutY="450" text="Parts Used" />
        <Label layoutX="520" layoutY="80" text="Completion Notes" />
        <Label layoutX="520" layoutY="250" text="Evidence Path" />
        <TextField fx:id="EvidencePathTF" layoutX="520" layoutY="275" prefWidth="230" />
        <Button layoutX="760" layoutY="275" onAction="#uploadEvidenceOA" text="Upload" />
        <Label layoutX="520" layoutY="350" text="Review" />
        <Label layoutX="520" layoutY="540" text="Notification" />
        <TextField fx:id="NotificationTF" editable="false" layoutX="600" layoutY="535" prefWidth="240" />
        <Button layoutX="180" layoutY="620" onAction="#reviewCompletionOA" prefWidth="140" text="Review" />
        <Button layoutX="340" layoutY="620" onAction="#completeTaskOA" prefWidth="160" text="Complete Task" />
        <Button layoutX="520" layoutY="620" onAction="#clearFormOA" prefWidth="120" text="Clear" />
      <TextField fx:id="CompletionNotesTF" editable="false" layoutX="535.0" layoutY="117.0" prefHeight="105.0" prefWidth="250" />
      <TextField fx:id="TaskDescriptionTF" editable="false" layoutX="179.0" layoutY="127.0" prefWidth="250" />
      <TextField fx:id="ReviewTF" layoutX="545.0" layoutY="392.0" prefHeight="116.0" prefWidth="230" />
      <TextField fx:id="WorkDoneTF" layoutX="190.0" layoutY="317.0" prefHeight="116.0" prefWidth="230" />
      <TextField fx:id="PartsUsedTF" layoutX="180.0" layoutY="450.0" prefHeight="116.0" prefWidth="230" />
    </children>
</AnchorPane>
