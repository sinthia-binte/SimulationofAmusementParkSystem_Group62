<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="750.0"
            prefWidth="950.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Veronica.MaintenanceTechnician.MaintenanceTechnicianDashboardController">


    <children>


        <!-- Title -->

        <Label layoutX="260.0"
               layoutY="20.0"
               style="-fx-font-size:26px; -fx-font-weight:bold;"
               text="Maintenance Technician Dashboard"/>



        <!-- Technician Information -->

        <Label layoutX="40.0"
               layoutY="80.0"
               style="-fx-font-size:16px;"
               text="Welcome:"/>


        <Label fx:id="technicianNameLabel"
               layoutX="130.0"
               layoutY="80.0"
               style="-fx-font-size:16px; -fx-font-weight:bold;"
               text="Unknown"/>




        <!-- Task Summary -->

        <Label layoutX="40.0"
               layoutY="130.0"
               style="-fx-font-size:18px; -fx-font-weight:bold;"
               text="Task Summary"/>


        <Label layoutX="50.0"
               layoutY="170.0"
               text="Pending:"/>


        <Label fx:id="pendingTaskLabel"
               layoutX="150.0"
               layoutY="170.0"
               text="0"/>



        <Label layoutX="50.0"
               layoutY="210.0"
               text="In Progress:"/>


        <Label fx:id="progressTaskLabel"
               layoutX="150.0"
               layoutY="210.0"
               text="0"/>



        <Label layoutX="50.0"
               layoutY="250.0"
               text="Completed:"/>


        <Label fx:id="completedTaskLabel"
               layoutX="150.0"
               layoutY="250.0"
               text="0"/>





        <!-- Alerts -->

        <Label layoutX="450.0"
               layoutY="130.0"
               style="-fx-font-size:18px; -fx-font-weight:bold;"
               text="Maintenance Alerts"/>


        <TextArea fx:id="alertTA"
                  layoutX="450.0"
                  layoutY="165.0"
                  prefHeight="120.0"
                  prefWidth="400.0"
                  editable="false"/>





        <!-- Assigned Tasks Table -->

        <Label layoutX="40.0"
               layoutY="310.0"
               style="-fx-font-size:18px; -fx-font-weight:bold;"
               text="Assigned Tasks"/>



        <TableView fx:id="taskTableTV"
                   layoutX="40.0"
                   layoutY="340.0"
                   prefHeight="150.0"
                   prefWidth="820.0">


            <columns>

                <TableColumn fx:id="taskIdTC"
                             prefWidth="200"
                             text="Task ID"/>


                <TableColumn fx:id="locationTC"
                             prefWidth="200"
                             text="Location"/>


                <TableColumn fx:id="priorityTC"
                             prefWidth="200"
                             text="Priority"/>


                <TableColumn fx:id="statusTC"
                             prefWidth="200"
                             text="Status"/>

            </columns>


        </TableView>





        <!-- Goal Buttons -->


        <!-- Goal 1 -->

        <Button layoutX="40"
                layoutY="530"
                prefWidth="190"
                onAction="#openAssignedTasksOA"
                text="Assigned Tasks"/>



        <!-- Goal 2 -->

        <Button layoutX="250"
                layoutY="530"
                prefWidth="190"
                onAction="#openRideInspectionOA"
                text="Ride Inspection"/>



        <!-- Goal 3 -->

        <Button layoutX="460"
                layoutY="530"
                prefWidth="190"
                onAction="#openMaintenanceRecordOA"
                text="Record Maintenance"/>



        <!-- Goal 4 -->

        <Button layoutX="670"
                layoutY="530"
                prefWidth="190"
                onAction="#openReportFaultOA"
                text="Report Fault"/>





        <!-- Goal 5 -->

        <Button layoutX="40"
                layoutY="590"
                prefWidth="190"
                onAction="#openPartsRequestOA"
                text="Request Parts"/>



        <!-- Goal 6 -->

        <Button layoutX="250"
                layoutY="590"
                prefWidth="190"
                onAction="#openUpdateStatusOA"
                text="Update Status"/>



        <!-- Goal 7 -->

        <Button layoutX="460"
                layoutY="590"
                prefWidth="190"
                onAction="#openManualOA"
                text="Repair Manuals"/>



        <!-- Goal 8 -->

        <Button layoutX="670"
                layoutY="590"
                prefWidth="190"
                onAction="#openCompleteTaskOA"
                text="Complete Tasks"/>




        <!-- Logout -->

        <Button layoutX="820"
                layoutY="30"
                prefWidth="80"
                onAction="#logoutOA"
                text="Logout"/>


    </children>

</AnchorPane>
