<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600" prefWidth="900" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Veronica.MaintenanceTechnician.MaintenancetDashboardController">
    <children>
        <Label layoutX="219.0" layoutY="14.0" style="-fx-font-size:24px; -fx-font-weight:bold;" text="Maintenance Technician Dashboard" />
        <Label layoutX="33.0" layoutY="56.0" text="Technician Name:" />
        <Label fx:id="TechnicianNameLabel" layoutX="16.0" layoutY="97.0" text="Maintenance Technician" />
        <Label layoutX="35.0" layoutY="136.0" style="-fx-font-size:18px; -fx-font-weight:bold;" text="Task Summary" />
        <Label layoutX="80" layoutY="200" text="Pending Tasks:" />
        <Label fx:id="PendingTaskLabel" layoutX="200" layoutY="200" prefHeight="18.0" prefWidth="101.0" text="0" />
        <Label layoutX="80" layoutY="240" text="In Progress:" />
        <Label fx:id="ProgressTaskLabel" layoutX="200" layoutY="240" text="0" />
        <Label layoutX="80" layoutY="280" text="Completed:" />
        <Label fx:id="CompletedTaskLabel" layoutX="200" layoutY="280" text="0" />
        <Label layoutX="400" layoutY="150" style="-fx-font-size:18px; -fx-font-weight:bold;" text="Maintenance Alerts" />
        <TextArea fx:id="AlertTA" editable="false" layoutX="400" layoutY="190" prefHeight="120" prefWidth="350" />
        <Label layoutX="50" layoutY="360" style="-fx-font-size:18px; -fx-font-weight:bold;" text="Menu" />
        <Button layoutX="50" layoutY="410" onAction="#openAssignedTasksOA" prefWidth="200" text="Assigned Tasks" />
        <Button layoutX="300" layoutY="410" onAction="#openHistoryOA" prefWidth="200" text="Maintenance History" />
        <Button layoutX="550" layoutY="410" onAction="#openReportIssueOA" prefWidth="200" text="Report Issue" />
        <Button layoutX="729.0" layoutY="35.0" onAction="#logoutOA" prefWidth="120" text="Logout" />
      <TextField fx:id="TechnicianNameTF" layoutX="144.0" layoutY="52.0" />
      <TextField fx:id="MaintenanceTechnicianTF" layoutX="168.0" layoutY="102.0" />
    </children>
</AnchorPane>
