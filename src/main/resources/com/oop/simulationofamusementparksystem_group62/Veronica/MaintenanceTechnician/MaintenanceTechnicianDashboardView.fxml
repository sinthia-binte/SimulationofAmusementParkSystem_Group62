<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="750.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Veronica.MaintenanceTechnician.MaintenanceTechnicianDashboardController">


    <children>

        <Label layoutX="260.0" layoutY="20.0" style="-fx-font-size:26px; -fx-font-weight:bold;" text="Maintenance Technician Dashboard" />




        <Label layoutX="40.0" layoutY="80.0" style="-fx-font-size:16px;" text="Welcome:" />


        <Label fx:id="technicianNameLabel" layoutX="130.0" layoutY="80.0" style="-fx-font-size:16px; -fx-font-weight:bold;" text="Unknown" />





        <Label layoutX="40.0" layoutY="130.0" style="-fx-font-size:18px; -fx-font-weight:bold;" text="Task Summary" />


        <Label layoutX="50.0" layoutY="170.0" text="Pending:" />


        <Label fx:id="pendingTaskLabel" layoutX="150.0" layoutY="170.0" text="0" />



        <Label layoutX="50.0" layoutY="210.0" text="In Progress:" />


        <Label fx:id="progressTaskLabel" layoutX="150.0" layoutY="210.0" text="0" />



        <Label layoutX="50.0" layoutY="250.0" text="Completed:" />


        <Label fx:id="completedTaskLabel" layoutX="150.0" layoutY="250.0" text="0" />






        <Label layoutX="450.0" layoutY="130.0" style="-fx-font-size:18px; -fx-font-weight:bold;" text="Maintenance Alerts" />


        <TextArea fx:id="alertTA" editable="false" layoutX="450.0" layoutY="165.0" prefHeight="120.0" prefWidth="400.0" />






        <Label layoutX="40.0" layoutY="310.0" style="-fx-font-size:18px; -fx-font-weight:bold;" text="Assigned Tasks" />



        <TableView fx:id="taskTableTV" layoutX="40.0" layoutY="340.0" prefHeight="150.0" prefWidth="820.0">


            <columns>

                <TableColumn fx:id="taskIdTC" prefWidth="200" text="Task ID" />


                <TableColumn fx:id="locationTC" prefWidth="200" text="Location" />


                <TableColumn fx:id="priorityTC" prefWidth="200" text="Priority" />


                <TableColumn fx:id="statusTC" prefWidth="200" text="Status" />

            </columns>


        </TableView>








        <Button layoutX="40.0" layoutY="530.0" onAction="#openAssignedTasksOA" prefWidth="190" text="Assigned Tasks" />


        <Button layoutX="250" layoutY="530" onAction="#openRideInspectionOA" prefWidth="190" text="Ride Inspection" />


        <Button layoutX="460" layoutY="530" onAction="#openMaintenanceRecordOA" prefWidth="190" text="Record Maintenance" />


        <Button layoutX="670" layoutY="530" onAction="#openReportFaultOA" prefWidth="190" text="Report Fault" />



        <Button layoutX="40" layoutY="590" onAction="#openPartsRequestOA" prefWidth="190" text="Request Parts" />


        <Button layoutX="250" layoutY="590" onAction="#openUpdateStatusOA" prefWidth="190" text="Update Status" />




        <Button layoutX="460" layoutY="590" onAction="#openManualOA" prefWidth="190" text="Repair Manuals" />




        <Button layoutX="670" layoutY="590" onAction="#openCompleteTaskOA" prefWidth="190" text="Complete Tasks" />





        <Button layoutX="820" layoutY="30" onAction="#logoutOA" prefWidth="80" text="Logout" />


    </children>

</AnchorPane>
