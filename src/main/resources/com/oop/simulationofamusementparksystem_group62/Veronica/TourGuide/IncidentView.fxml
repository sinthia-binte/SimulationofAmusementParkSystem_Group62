<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="650" prefWidth="900" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Veronica.TourGuide.IncidentController">
    <children>
        <Label layoutX="270" layoutY="30" style="-fx-font-size:24px; -fx-font-weight:bold;" text="Guest Incident Report" />
        <Label layoutX="50" layoutY="90" text="Select Tour Session" />
        <ComboBox fx:id="SessionCB" layoutX="200.0" layoutY="86.0" prefWidth="300" />
        <Label layoutX="50" layoutY="150" text="Guest Name" />
        <TextField fx:id="GuestNameTF" layoutX="200" layoutY="145" prefWidth="300" />
        <Label layoutX="50" layoutY="200" text="Incident Time" />
        <TextField fx:id="TimeTF" layoutX="200" layoutY="195" prefWidth="300" promptText="Enter time" />
        <Label layoutX="50" layoutY="250" text="Location" />
        <TextField fx:id="LocationTF" layoutX="200" layoutY="245" prefWidth="300" />
        <Label layoutX="50" layoutY="310" text="Incident Description" />
        <TextArea fx:id="DescriptionTA" layoutX="200" layoutY="305" prefHeight="100" prefWidth="400" />
        <Button layoutX="200" layoutY="500" onAction="#reviewReportOA" prefWidth="150" text="Review Report" />
        <Button layoutX="400" layoutY="500" onAction="#submitReportOA" prefWidth="150" text="Submit Incident" />
        <TextArea fx:id="ConfirmationTA" editable="false" layoutX="50" layoutY="560" prefHeight="60" prefWidth="800" />
      <Button layoutX="589.0" layoutY="499.0" mnemonicParsing="false" onAction="#BackToDashboardOA" prefHeight="26.0" prefWidth="150.0" text="Back" />
    </children>
</AnchorPane>
