<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="650" prefWidth="900" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Veronica.TourGuide.TourCompletionController">

    <children>

        <Label layoutX="260" layoutY="30" style="-fx-font-size:24px; -fx-font-weight:bold;" text="Close Completed Tour" />

        <Button layoutX="627" layoutY="58" onAction="#BackToDashboardOA" prefWidth="180" text="Back to Dashboard" />

        <Label layoutX="50" layoutY="90" text="Select Tour Session" />

        <ComboBox fx:id="TourSessionCB" layoutX="182.0" layoutY="86.0" onAction="#selectTourOA" prefWidth="300" />

        <Label layoutX="50" layoutY="150" text="Guest Count" />

        <TextField fx:id="GuestCountTF" editable="false" layoutX="200" layoutY="145" />

        <Label layoutX="50" layoutY="200" text="Attendance" />

        <TextField fx:id="AttendanceTF" editable="false" layoutX="200" layoutY="195" />

        <Label layoutX="50" layoutY="250" text="Duration" />

        <TextField fx:id="DurationTF" editable="false" layoutX="200" layoutY="245" />

        <Label layoutX="50" layoutY="310" text="Completion Summary" />

        <TextArea fx:id="SummaryTA" layoutX="200" layoutY="305" prefHeight="100" prefWidth="300" wrapText="true" />

        <Button layoutX="200" layoutY="440" onAction="#reviewCompletionOA" prefWidth="120" text="Review" />

        <Button layoutX="370" layoutY="440" onAction="#submitCompletionOA" prefWidth="150" text="Close Tour" />

        <Label fx:id="ReviewLabel" layoutX="550" layoutY="150" prefHeight="180" prefWidth="300" wrapText="true" />

        <Label fx:id="ConfirmationLabel" layoutX="200" layoutY="500" prefHeight="80" prefWidth="400" wrapText="true" />
    </children>
</AnchorPane>
