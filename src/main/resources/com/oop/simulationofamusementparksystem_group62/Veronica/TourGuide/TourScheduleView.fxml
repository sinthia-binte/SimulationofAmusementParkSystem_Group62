<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Veronica.TourGuide.TourScheduleController">
    <children>
        <Label layoutX="280" layoutY="30" style="-fx-font-size:24px; -fx-font-weight:bold;" text="Assigned Tour Schedule" />
        <TableView fx:id="ScheduleTable" layoutX="50" layoutY="100" prefHeight="300" prefWidth="800">
            <columns>
                <TableColumn fx:id="TourNameColumn" prefWidth="150" text="Tour Name" />

                <TableColumn fx:id="DateColumn" prefWidth="120" text="Date" />

                <TableColumn fx:id="TimeColumn" prefWidth="120" text="Time" />

                <TableColumn fx:id="LocationColumn" prefWidth="150" text="Location" />
            </columns>
        </TableView>
        <Button layoutX="350" layoutY="450" onAction="#viewDetailsOA" prefWidth="180" text="View Details" />
      <Label fx:id="DetailsLabel" layoutX="77.0" layoutY="491.0" prefHeight="72.0" prefWidth="646.0" />
    </children>

</AnchorPane>
