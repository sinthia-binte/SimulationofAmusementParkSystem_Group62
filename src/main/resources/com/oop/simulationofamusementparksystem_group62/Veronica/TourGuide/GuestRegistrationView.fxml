<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="650.0" prefWidth="850.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Veronica.TourGuide.GuestRegistrationController">
    <children>
        <Label layoutX="280.0" layoutY="25.0" style="-fx-font-size:24px; -fx-font-weight:bold;" text="Guest Registration" />
        <Label layoutX="50.0" layoutY="90.0" text="Select Tour Session" />
        <ComboBox fx:id="TourSessionCB" layoutX="180.0" layoutY="85.0" prefWidth="250.0" />
        <Label layoutX="50.0" layoutY="140.0" text="Group Name" />
        <TextField fx:id="GroupNameTF" layoutX="180.0" layoutY="135.0" prefWidth="250.0" />
        <Label layoutX="50.0" layoutY="190.0" text="Number of Guests" />
        <TextField fx:id="NumberGuestTF" layoutX="180.0" layoutY="185.0" prefWidth="250.0" />
        <Label layoutX="50.0" layoutY="240.0" text="Guest Details" />
        <TextArea fx:id="GuestDetailsTA" layoutX="180.0" layoutY="235.0" prefHeight="90.0" prefWidth="250.0" />
        <Label layoutX="470.0" layoutY="140.0" text="Contact Information" />

        <TextField fx:id="ContactTF" layoutX="600.0" layoutY="135.0" prefWidth="200.0" />
        <Label layoutX="470.0" layoutY="190.0" text="Payment Information" />
        <TextField fx:id="PaymentTF" layoutX="600.0" layoutY="185.0" prefWidth="200.0" />
        <Button layoutX="250.0" layoutY="360.0" onAction="#previewRegistrationOA" prefWidth="170.0" text="Preview Registration" />
        <Button layoutX="450.0" layoutY="360.0" onAction="#submitRegistrationOA" prefWidth="170.0" text="Submit Registration" />
        <Label layoutX="50.0" layoutY="430.0" text="Registration Details" />

        <TextArea fx:id="PreviewTA" editable="false" layoutX="50.0" layoutY="455.0" prefHeight="150.0" prefWidth="750.0" />
      <Button layoutX="626.0" layoutY="47.0" mnemonicParsing="false" onAction="#BackToDashboardOA" prefHeight="26.0" prefWidth="148.0" text="Back" />
    </children>

</AnchorPane>
