<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="540.0" prefWidth="850.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Sinthia.SecurityInCharge.EmergencyResponseManagementViewController">

    <children>

        <Label layoutX="300.0" layoutY="25.0"
               text="Emergency Response"
               style="-fx-background-color: pink;">
            <font><Font size="24.0"/></font>
        </Label>

        <Text layoutX="30.0" layoutY="90.0"
              text="Emergency Plan :" />
        <ComboBox fx:id="emergencyPlanCB"
                  layoutX="150.0" layoutY="72.0"
                  prefWidth="160.0"/>

        <Text layoutX="30.0" layoutY="135.0"
              text="Drill Date :" />
        <DatePicker fx:id="drillDateDP"
                    layoutX="150.0" layoutY="117.0"
                    prefWidth="160.0"/>

        <Text layoutX="30.0" layoutY="180.0"
              text="Drill Type :" />
        <ComboBox fx:id="drillTypeCB"
                  layoutX="150.0" layoutY="162.0"
                  prefWidth="160.0"/>

        <Text layoutX="30.0" layoutY="225.0"
              text="Participants :" />
        <TextField fx:id="participantsTF"
                   layoutX="150.0" layoutY="207.0"
                   prefWidth="160.0"/>

        <Text layoutX="30.0" layoutY="270.0"
              text="Emergency Type :" />
        <ComboBox fx:id="emergencyTypeCB"
                  layoutX="150.0" layoutY="252.0"
                  prefWidth="160.0"/>

        <Text layoutX="30.0" layoutY="315.0"
              text="Response Action :" />
        <TextArea fx:id="responseActionTA"
                  layoutX="150.0" layoutY="295.0"
                  prefHeight="65.0" prefWidth="180.0"/>

        <Text layoutX="30.0" layoutY="390.0"
              text="Evacuation / Rescue :" />
        <TextArea fx:id="evacuationTA"
                  layoutX="150.0" layoutY="370.0"
                  prefHeight="65.0" prefWidth="180.0"/>

        <Button layoutX="70.0" layoutY="460.0"
                text="Save"
                onAction="#saveEmergencyButtonOA"/>

        <Button layoutX="160.0" layoutY="460.0"
                text="Update"
                onAction="#updateEmergencyButtonOA"/>

        <Button layoutX="255.0" layoutY="460.0"
                text="Delete"
                onAction="#deleteEmergencyButtonOA"/>

        <TableView fx:id="emergencyTableView"
                   layoutX="350.0" layoutY="75.0"
                   prefHeight="360.0" prefWidth="470.0">

            <columns>
                <TableColumn fx:id="planTC"
                             prefWidth="90.0"
                             text="Plan"/>

                <TableColumn fx:id="drillDateTC"
                             prefWidth="85.0"
                             text="Drill Date"/>

                <TableColumn fx:id="drillTypeTC"
                             prefWidth="90.0"
                             text="Drill Type"/>

                <TableColumn fx:id="emergencyTypeTC"
                             prefWidth="100.0"
                             text="Emergency"/>

                <TableColumn fx:id="responseTC"
                             prefWidth="105.0"
                             text="Response"/>
            </columns>

        </TableView>

    </children>
</AnchorPane>