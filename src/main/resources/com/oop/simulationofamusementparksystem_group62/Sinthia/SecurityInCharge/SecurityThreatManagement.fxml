<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.control.Label?>

<AnchorPane prefHeight="520.0" prefWidth="850.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Sinthia.SecurityInCharge.SecurityThreatManagementViewController">
    <children>
        <Label layoutX="315.0" layoutY="25.0"
               text="Security Threat Management"
               style="-fx-background-color: pink;">
            <font><Font size="24.0"/></font>
        </Label>
        <Text layoutX="30.0" layoutY="90.0" text="Incident Type :" />
        <ComboBox fx:id="incidentTypeCB" layoutX="145.0" layoutY="72.0" prefWidth="160.0"/>
        <Text layoutX="30.0" layoutY="135.0" text="Location :" />
        <TextField fx:id="incidentLocationTF" layoutX="145.0" layoutY="117.0" prefWidth="160.0"/>
        <Text layoutX="30.0" layoutY="180.0" text="Frequency :" />
        <TextField fx:id="frequencyTF" layoutX="145.0" layoutY="162.0" prefWidth="160.0"/>
        <Text layoutX="30.0" layoutY="225.0" text="High-Risk Area :" />
        <TextField fx:id="highRiskAreaTF" layoutX="145.0" layoutY="207.0" prefWidth="160.0"/>
        <Text layoutX="30.0" layoutY="270.0" text="Assigned Personnel :" />
        <ComboBox fx:id="personnelCB" layoutX="145.0" layoutY="252.0" prefWidth="160.0"/>
        <Text layoutX="30.0" layoutY="315.0" text="Corrective Action :" />
        <TextArea fx:id="correctiveActionTA" layoutX="145.0" layoutY="295.0" prefHeight="70.0" prefWidth="180.0"/>
        <Button layoutX="70.0" layoutY="400.0" text="Save" onAction="#saveThreatButtonOA"/>
        <Button layoutX="160.0" layoutY="400.0" text="Update" onAction="#updateThreatButtonOA"/>
        <Button layoutX="255.0" layoutY="400.0" text="Delete" onAction="#deleteThreatButtonOA"/>
        <TableView fx:id="threatTableView" layoutX="350.0" layoutY="75.0" prefHeight="330.0" prefWidth="470.0">
            <columns>
                <TableColumn fx:id="incidentTypeTC" prefWidth="90.0" text="Type"/>
                <TableColumn fx:id="locationTC" prefWidth="90.0" text="Location"/>
                <TableColumn fx:id="frequencyTC" prefWidth="80.0" text="Frequency"/>
                <TableColumn fx:id="riskAreaTC" prefWidth="100.0" text="Risk Area"/>
                <TableColumn fx:id="personnelTC" prefWidth="110.0" text="Personnel"/>
            </columns>
        </TableView>
    </children>
</AnchorPane>