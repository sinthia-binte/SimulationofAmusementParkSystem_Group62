<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="540.0" prefWidth="850.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Sinthia.SecurityInCharge.SecurityStaffTrainingManagementViewController">

    <children>

        <Label layoutX="290.0" layoutY="25.0"
               text="Security Staff Training"
               style="-fx-background-color: pink;">
            <font><Font size="24.0"/></font>
        </Label>

        <Text layoutX="30.0" layoutY="90.0"
              text="Training Topic :" />
        <TextField fx:id="trainingTopicTF"
                   layoutX="150.0" layoutY="72.0"
                   prefWidth="160.0"/>

        <Text layoutX="30.0" layoutY="135.0"
              text="Training Date :" />
        <DatePicker fx:id="trainingDateDP"
                    layoutX="150.0" layoutY="117.0"
                    prefWidth="160.0"/>

        <Text layoutX="30.0" layoutY="180.0"
              text="Staff Member :" />
        <ComboBox fx:id="staffCB"
                  layoutX="150.0" layoutY="162.0"
                  prefWidth="160.0"/>

        <Text layoutX="30.0" layoutY="225.0"
              text="Training Type :" />
        <ComboBox fx:id="trainingTypeCB"
                  layoutX="150.0" layoutY="207.0"
                  prefWidth="160.0"/>

        <Text layoutX="30.0" layoutY="270.0"
              text="Assessment :" />
        <TextField fx:id="assessmentTF"
                   layoutX="150.0" layoutY="252.0"
                   prefWidth="160.0"/>

        <Text layoutX="30.0" layoutY="315.0"
              text="Feedback :" />
        <TextArea fx:id="feedbackTA"
                  layoutX="150.0" layoutY="295.0"
                  prefHeight="65.0" prefWidth="180.0"/>

        <Text layoutX="30.0" layoutY="390.0"
              text="Additional Training :" />
        <TextField fx:id="additionalTrainingTF"
                   layoutX="150.0" layoutY="372.0"
                   prefWidth="160.0"/>

        <Button layoutX="70.0" layoutY="430.0"
                text="Save"
                onAction="#saveTrainingButtonOA"/>

        <Button layoutX="160.0" layoutY="430.0"
                text="Update"
                onAction="#updateTrainingButtonOA"/>

        <Button layoutX="255.0" layoutY="430.0"
                text="Delete"
                onAction="#deleteTrainingButtonOA"/>

        <TableView fx:id="trainingTableView"
                   layoutX="350.0" layoutY="75.0"
                   prefHeight="355.0" prefWidth="470.0">

            <columns>
                <TableColumn fx:id="topicTC"
                             prefWidth="100.0"
                             text="Topic"/>

                <TableColumn fx:id="dateTC"
                             prefWidth="85.0"
                             text="Date"/>

                <TableColumn fx:id="staffTC"
                             prefWidth="100.0"
                             text="Staff"/>

                <TableColumn fx:id="typeTC"
                             prefWidth="90.0"
                             text="Type"/>

                <TableColumn fx:id="assessmentTC"
                             prefWidth="95.0"
                             text="Assessment"/>
            </columns>

        </TableView>

    </children>
</AnchorPane>