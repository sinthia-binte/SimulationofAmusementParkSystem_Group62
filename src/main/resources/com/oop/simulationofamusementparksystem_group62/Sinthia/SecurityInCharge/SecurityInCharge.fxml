<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="500.0" prefWidth="850.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Sinthia.SecurityInCharge.SecurityInChargeViewController">
    <children>
        <Label fx:id="securityLabel"
               layoutX="315.0"
               layoutY="25.0"
               text="Security Monitoring"
               style="-fx-background-color: pink;">
            <font>
                <Font size="24.0"/>
            </font>
        </Label>
        <Text layoutX="30.0" layoutY="90.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Security Status :" />
        <TextField fx:id="securityStatusTF" layoutX="145.0" layoutY="72.0" prefWidth="130.0" />
        <Text layoutX="30.0" layoutY="135.0" strokeType="OUTSIDE" strokeWidth="0.0" text="CCTV / Alert :" />
        <TextField fx:id="cctvAlertTF" layoutX="145.0" layoutY="117.0" prefWidth="130.0" />
        <Text layoutX="30.0" layoutY="180.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Security Record :" />
        <TextField fx:id="securityRecordTF" layoutX="145.0" layoutY="162.0" prefWidth="130.0" />
        <Text layoutX="30.0" layoutY="225.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Patrol Area :" />
        <TextField fx:id="patrolAreaTF" layoutX="145.0" layoutY="207.0" prefWidth="130.0" />
        <Text layoutX="30.0" layoutY="270.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Access Permission :" />
        <TextField fx:id="accessPermissionTF" layoutX="145.0" layoutY="252.0" prefWidth="130.0" />
        <Text layoutX="30.0" layoutY="315.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Incident Details :" />
        <TextArea fx:id="incidentTA" layoutX="145.0" layoutY="295.0" prefHeight="70.0" prefWidth="180.0" />
        <Button fx:id="saveButton" layoutX="90.0" layoutY="400.0" mnemonicParsing="false" onAction="#saveSecurityButtonOA" text="Save" />
        <Button fx:id="updateButton" layoutX="180.0" layoutY="400.0" mnemonicParsing="false" onAction="#updateSecurityButtonOA" text="Update" />
        <Button fx:id="deleteButton" layoutX="275.0" layoutY="400.0" mnemonicParsing="false" onAction="#deleteSecurityButtonOA" text="Delete" />
        <TableView fx:id="securityTableView" layoutX="350.0" layoutY="75.0" prefHeight="300.0" prefWidth="470.0">
            <columns>
                <TableColumn fx:id="statusTC" prefWidth="90.0" text="Status" />
                <TableColumn fx:id="cctvTC" prefWidth="90.0" text="CCTV Alert" />
                <TableColumn fx:id="recordTC" prefWidth="90.0" text="Record" />
                <TableColumn fx:id="patrolTC" prefWidth="90.0" text="Patrol Area" />
                <TableColumn fx:id="permissionTC" prefWidth="110.0" text="Permission" />
            </columns>

        </TableView>

    </children>

</AnchorPane>